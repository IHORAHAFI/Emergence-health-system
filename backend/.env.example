# Copy to backend/.env and fill in. NEVER commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database: leave DB_NAME empty to use SQLite (backend/db.sqlite3) ---
# Set these to use PostgreSQL (recommended for real patient data; see database/setup_postgres.sql)
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- SMS: simulate | africastalking | twilio | generic ---
# "simulate" stores the message and marks it SIMULATED - nothing is sent to a phone.
SMS_PROVIDER=simulate
SMS_SENDER_ID=
# Africa's Talking (use AT_USERNAME=sandbox for the free sandbox)
AT_USERNAME=
AT_API_KEY=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Any provider with a simple JSON POST {"to","message"} + Bearer key
SMS_API_URL=
SMS_API_KEY=

# --- Push notifications to the Flutter app (Firebase) ---
NOTIFICATIONS_SIMULATE=True
FCM_SERVER_KEY=

# --- Behaviour ---
EMERGENCY_HOTLINE=912
DUPLICATE_WINDOW_MINUTES=30
AMBULANCE_AVG_SPEED_KMH=40

# --- Optional: LLM rephrasing for the health information assistant ---
# Without a key the assistant answers extractively from its curated knowledge base.
ANTHROPIC_API_KEY=
# Model for grounded answers (code default: claude-opus-5-5; haiku is much cheaper)
RAG_LLM_MODEL=claude-haiku-5-5
# Saved assistant conversations are deleted after this many days
ASSISTANT_HISTORY_DAYS=30

# --- Optional: Redis channel layer for WebSockets with several server processes ---
REDIS_URL=
